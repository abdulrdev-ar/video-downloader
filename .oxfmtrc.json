{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "experimentalSortImports": {},
  "experimentalTailwindcss": { "stylesheet": "./src/app/globals.css" },
  "ignorePatterns": [
    "**/*.md",
    "graphify-out/**",
    ".playwright-mcp/**",
    "pnpm-lock.yaml"
  ]
}
